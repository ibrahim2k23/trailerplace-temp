# TrailerPlace chatbot — environment template.
# ---- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
ANALYZE_MODEL=gpt-5-mini
ANALYZE_REASONING_EFFORT=minimal

# ---- Search / rerank knobs --------------------------------------------------
SEARCH_MAX_RECOMMENDATIONS=5
FEATURE_LLM_RERANK_ENABLED=1
FEATURE_RERANK_MODEL=gpt-5-nano-2025-08-07
FEATURE_RERANK_REASONING_EFFORT=medium
FEATURE_RERANK_TIMEOUT_SECONDS=60
FEATURE_RERANK_BATCH_SIZE=20
FEATURE_RERANK_MAX_PARALLEL_BATCHES=4
FEATURE_RERANK_WEIGHT=0.85
FEATURE_FIT_WEIGHT=0.15
RERANK_ENABLED=true
RERANK_WARN_RATIO=1.35
RERANK_EXTREME_RATIO=1.9
RERANK_LENGTH_WEIGHT=8.0
RERANK_MISSING_DIM_PENALTY=0.35
RERANK_VERBOSE_LOGS=false
MAKE_RERANK_VERBOSE_LOGS=false
# true = show a trailer card only when the reply cites its URL
SHOW_ONLY_LLM_MENTIONED_CARDS=true
TRAILERPLACE_WEBSITE=https://trailerplace.com

# ---- Streamlit frontend gate (app.py) ---------------------------------------
TRAILERPLACE_APP_USERNAME=changeme
TRAILERPLACE_APP_PASSWORD=changeme

# ---- Database (Postgres) ----------------------------------------------------
# Persistence turns on only when ALL five are set.
HOST=your-db.postgres.database.azure.com
PORT=5432
DATABASE=postgres
PGUSER=dbadmin
PASSWORD=change-me
# Set to 0/false/off to run fully in-memory even with a DB configured.
TRAILERPLACE_PERSIST_CHATS=1
# Run `alembic upgrade head` automatically on boot. Otherwise run it by hand first.
DB_AUTO_CREATE=0
# Only for `pytest -m db`. Points the DB-marked tests at a throwaway database.
TEST_DATABASE_URL=postgresql+psycopg://postgres:test@localhost:5433/postgres

# ---- Email ------------------------------------------------------------------
# `graph` (Microsoft Graph, uses requests — no msal) or `smtp` (stdlib smtplib).
EMAIL_BACKEND=graph

# Graph backend
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=change-me
SENDER_EMAIL=bot@yourdomain.com
RECIPIENT_EMAIL=leads@yourdomain.com

# SMTP backend (note: the SMTP recipient is EMAIL_TO, not RECIPIENT_EMAIL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bot@yourdomain.com
SMTP_PASSWORD=change-me
SMTP_FROM=bot@yourdomain.com
EMAIL_TO=leads@yourdomain.com

# ---- API --------------------------------------------------------------------
CHATBOT_API_PORT=8000
# Exposes GET /session/{id}/state. Required by scripts/convo_runner.py. Keep OFF in prod.
DEBUG_STATE_ENDPOINT=0
INVENTORY_LOOKUP_LIMIT=5
# Streaming: serves POST /chat/stream and makes the Streamlit UI use it, so a reply is typed
# out as it arrives and lands as several messages (intro, one per trailer, closing question)
# instead of one wall of text. 0 falls back to blocking POST /chat and a single bubble.
CHAT_STREAM_ENABLED=1
# Pacing only - the reply is finished and validated before a word of it is sent.
CHAT_STREAM_WORDS_PER_DELTA=3
CHAT_STREAM_DELTA_SECONDS=0.035
CHAT_STREAM_CHUNK_PAUSE_SECONDS=0.45

# ---- Observability (M9) -----------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=TrailerPlace
# text | json
LOG_FORMAT=text
LOG_LEVEL=INFO
# Directory for the daily console-mirrored log file (<LOG_DIR>/<YYYY-MM-DD>.log) —
# every chat_turn record and the human-readable conversation reasoning block.
LOG_DIR=logs
# Append-only JSONL of per-turn records. Required by scripts/cost_report.py.
TURN_LOG_PATH=turns.jsonl
